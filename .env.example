# WebRyza Cards Form - Environment Variables Template
# Copy this file to .env for local development

# Firebase Client Configuration (From Firebase Console > Project Settings > Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# WhatsApp Support Number for Confirmation Screen (format: CountryCode + 10 digits without +)
VITE_WHATSAPP_SUPPORT_NUMBER=919876543210

# Cloudinary Integration (Serverless API - Configure in Vercel Project Settings)
# DO NOT commit API Secret to GitHub!
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudinary Client Configuration (Optional for local Vite development fallback)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=webryza_unsigned_preset
