rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identifies partner login accounts via their deterministic synthetic email domain
    function isPartner() {
      return isAuthenticated() && 
        (request.auth.token.email.matches('.*@partner\\.webryza\\.in$') ||
         ('role' in request.auth.token && request.auth.token.role == 'partner'));
    }

    // WebRyza Administrator: Any authenticated staff member who is not a partner
    function isAdmin() {
      return isAuthenticated() && !isPartner();
    }

    // Helper to check if a partner owns a record via their authUid or loginEmail in wedding_partners
    function isPartnerRecordOwner(partnerId) {
      return isPartner() && 
        partnerId != null && 
        partnerId != '' &&
        exists(/databases/$(database)/documents/wedding_partners/$(partnerId)) &&
        (
          get(/databases/$(database)/documents/wedding_partners/$(partnerId)).data.authUid == request.auth.uid ||
          get(/databases/$(database)/documents/wedding_partners/$(partnerId)).data.loginEmail == request.auth.token.email
        );
    }

    // ==================================================
    // 1. WebRyza Existing Projects Collection
    // ==================================================
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }

    // ==================================================
    // 2. Wedding Partners Collection
    // ==================================================
    match /wedding_partners/{partnerId} {
      allow read, write: if isAdmin();

      // Partners can read their own profile by authUid or loginEmail
      allow get: if isPartner() && (
        resource.data.authUid == request.auth.uid ||
        resource.data.loginEmail == request.auth.token.email
      );

      // Allow partner to auto-bind their authUid upon login
      allow update: if isPartner() && 
        (resource.data.loginEmail == request.auth.token.email || resource.data.authUid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'updatedAt']);

      // Public registration form can read active partner info to display shop name
      allow get: if resource.data.isActive == true;
    }

    // ==================================================
    // 3. Partner Usernames Mapping Collection
    // ==================================================
    match /partner_usernames/{username} {
      allow read, write: if isAdmin();
      allow get: if true;
    }

    // ==================================================
    // 4. Wedding Cards Collection (Master Records)
    // ==================================================
    match /wedding_cards/{cardId} {
      allow write: if isAdmin();

      // Allow guests, couples, partners, and admins to read the invitation
      allow read: if true;

      // Public registration form submission with strict business validation
      allow create: if 
        request.resource.data.amountCharged is number &&
        request.resource.data.amountCharged >= 1500 &&
        request.resource.data.brideName is string &&
        request.resource.data.brideName.size() > 0 &&
        request.resource.data.groomName is string &&
        request.resource.data.groomName.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.amountReceivedByWebryza == 0 &&
        (
          (request.resource.data.amountCharged < 2000 && request.resource.data.webryzaShare == 1000) ||
          (request.resource.data.amountCharged >= 2000 && request.resource.data.webryzaShare == 1500)
        );
    }

    // ==================================================
    // 5. Public Sanitized Wedding Invitations
    // ==================================================
    match /public_invitations/{invitationId} {
      allow read: if true;
      allow create: if request.resource.data.weddingId is string
                    && request.resource.data.brideName is string;
      allow update, delete: if isAdmin();
    }

    // ==================================================
    // 6. System Counters (For Sequential Wedding IDs)
    // ==================================================
    match /system_counters/{counterId} {
      allow read, write: if true;
    }

    // ==================================================
    // 7. Wedding Payments Collection
    // ==================================================
    match /wedding_payments/{paymentId} {
      allow read, write: if isAdmin();
      allow read: if isPartnerRecordOwner(resource.data.partnerId);
    }
  }
}
