rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == "admin@webryza.in" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Partner directory:
    // - Public can read partner details to verify QR codes and display shop names
    // - Only WebRyza Admin can create, edit, or delete partner accounts
    match /wedding_partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Wedding Cards Registrations:
    // - Public can SUBMIT (create) their wedding registration
    // - Public cannot read or modify any registrations
    // - Authenticated Partners can READ ONLY their own registered projects (Read-Only)
    // - Partners CANNOT edit, update, or delete any registration or payment data
    // - WebRyza Admin has full access to read and update
    match /wedding_cards/{registrationId} {
      allow create: if request.resource.data.brideName is string
                    && request.resource.data.groomName is string
                    && request.resource.data.phone is string
                    && request.resource.data.amountCharged is number
                    && request.resource.data.amountCharged >= 1500;

      // Read permission: Admin can read all; Partners can read ONLY projects matching their partnerId
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.partnerId == request.auth.uid ||
        (exists(/databases/$(database)/documents/wedding_partners/$(request.auth.uid)) &&
         resource.data.partnerId == get(/databases/$(database)/documents/wedding_partners/$(request.auth.uid)).data.partnerId) ||
        resource.data.partnerId == request.auth.token.email.split('@')[0]
      );

      // Only WebRyza Admin can update payments, website URLs, or delete registrations
      allow update, delete: if isAdmin();
    }

    // Preserve existing admin panel rules for other collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
