rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if caller is authenticated (Admin)
    function isAdmin() {
      return request.auth != null;
    }

    // =========================================================================
    // 1. WEDDING CARDS & REGISTRATION FORMS
    // =========================================================================

    // Wedding card submissions from couples / clients
    // Public can CREATE (submit the form without login)
    // Only Admin can read, list, update payment status, or delete submissions
    match /wedding_cards/{cardId} {
      allow create: if request.resource.data.brideName is string
                    && request.resource.data.groomName is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    // Wedding partners directory (for shop referral code verification & discount lookups)
    // Public can read to validate referral codes; only Admin can manage partners
    match /wedding_partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Optional digital wedding RSVPs / Guest wishes submitted by wedding guests
    match /wedding_rsvps/{rsvpId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /wedding_orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 2. WEBRYZA CONTACT FORMS & CLIENT INQUIRIES
    // =========================================================================

    // Contact messages, lead submissions, and quote requests
    // Public can CREATE (send inquiries without logging in)
    // Only Admin can read the messages and manage client requests
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. GESTURE STUDIO / COMMUNITY COLLECTIONS (If sharing project)
    // =========================================================================

    match /leaderboards/{board}/entries/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // =========================================================================
    // 4. DEFAULT FALLBACK
    // =========================================================================
    // All other collections require admin authentication
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
